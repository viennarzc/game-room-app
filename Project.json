{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Game Room",
  "options": {
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "Game Room": {
      "dependencies": [
        {
          "embed": true,
          "target": "Game Room Widget"
        }
      ],
      "deploymentTarget": "26.0",
      "entitlements": {
        "path": "App/New Project.entitlements",
        "properties": {
          "com.apple.security.app-sandbox": true
        }
      },
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Game Room",
          "LSApplicationCategoryType": "public.app-category.games",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ]
        }
      },
      "platform": "auto",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.970a7539-7948-4f5a-a34a-5eaeb24e13f7",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2"
      },
      "sources": [
        {
          "path": "App"
        }
      ],
      "supportedDestinations": [
        "iOS",
        "macOS"
      ],
      "type": "application"
    },
    "Game Room Widget": {
      "deploymentTarget": "26.0",
      "entitlements": {
        "path": "Widget/Widget.entitlements",
        "properties": {
          "com.apple.security.app-sandbox": true
        }
      },
      "info": {
        "path": "Widget/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Game Room Widget",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "NSExtension": {
            "NSExtensionPointIdentifier": "com.apple.widgetkit-extension"
          }
        }
      },
      "platform": "auto",
      "settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.970a7539-7948-4f5a-a34a-5eaeb24e13f7.widget-extension",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
        "SWIFT_VERSION": "5.0"
      },
      "sources": [
        {
          "path": "Widget"
        }
      ],
      "supportedDestinations": [
        "iOS",
        "macOS"
      ],
      "type": "app-extension"
    }
  }
}
